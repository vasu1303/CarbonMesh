# Send only API source, its package definition, and canonical demo inputs.
**
!apps/
apps/*
!apps/api/
apps/api/*
!apps/api/pyproject.toml
!apps/api/app/
!apps/api/app/**
!data/
data/*
!data/demo/
data/demo/*
!data/demo/*.csv
!data/demo/*.json
!data/demo/*.md
!data/demo/*.txt

# Keep local credentials, environments, caches, and tests out of allowed trees.
**/.env
**/.env.*
**/.venv
**/.venv/**
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.egg-info
**/*.egg-info/**
**/.pytest_cache
**/.pytest_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/tests
**/tests/**
**/node_modules
**/node_modules/**
