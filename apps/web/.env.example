VITE_API_BASE_URL=/api
# Local development only. Match apps/api/.env AUTH_REQUIRED=false.
# Set both flags to true to restore sign-in. Production builds always require it.
VITE_AUTH_REQUIRED=false
# Optional existing actor UUID for explicit local commands when auth is off.
# Leave blank to enter the acting user on each command form. This is not a credential.
VITE_ACTOR_ID=
# Optional destructive operator control. Keep disabled for normal development.
# The target is a nonsecret operator label, not a server-verified database identity.
VITE_DEMO_RESET_ENABLED=false
VITE_DEMO_RESET_TARGET=
# Seeded demo identifiers. Override all four for another existing context.
VITE_COMPANY_ID=00000000-0000-4000-8000-000000000001
VITE_SITE_ID=00000000-0000-4000-8000-000000000002
VITE_REPORTING_PERIOD_ID=00000000-0000-4000-8000-000000000003
VITE_METRIC_DEFINITION_ID=00000000-0000-4000-8000-000000000102
