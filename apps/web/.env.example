VITE_API_BASE_URL=/api
# This frontend has no login flow. Use AUTH_REQUIRED=false only for a trusted
# local/demo backend. Do not expose an unauthenticated API publicly.
# Optional preferred actor. Forms select named active users from the API.
# This internal reference is not a credential.
VITE_ACTOR_ID=
# Seeded demo identifiers. Override all four for another existing context.
VITE_COMPANY_ID=00000000-0000-4000-8000-000000000001
VITE_SITE_ID=00000000-0000-4000-8000-000000000002
VITE_REPORTING_PERIOD_ID=00000000-0000-4000-8000-000000000003
VITE_METRIC_DEFINITION_ID=00000000-0000-4000-8000-000000000102
