# Copy this file to .env and replace the placeholder with a rotated Neon pooled URL.
# Keep .env local; it is ignored by git. Never commit, print, or paste a real credential.
# Use the raw URL from Neon (not Markdown); keep reserved password characters URL-encoded.
# The backend converts this URL to postgresql+asyncpg and enforces TLS itself.
DATABASE_URL=postgresql://neondb_owner:replace-with-rotated-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional server-side Electricity Maps V4 credential. Keep it out of frontend code,
# request payloads, responses, logs, and committed files.
ELECTRICITY_MAPS_API_TOKEN=
# External calls are bounded; accepted values are 1 through 30 seconds.
ELECTRICITY_MAPS_TIMEOUT_SECONDS=10
