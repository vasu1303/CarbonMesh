# Copy this file to .env. For normal shared development, replace the placeholder
# with the Neon pooled URL. The Docker Compose configuration uses the local
# example shown below instead.
# Keep .env local; it is ignored by git. Never commit, print, or paste a real credential.
# Use the raw URL from Neon (not Markdown); keep reserved password characters URL-encoded.
# The hosted database path is /carbonmesh. The Neon login role may still be named
# neondb_owner; role names do not select the database.
# The backend converts this URL to postgresql+asyncpg and enforces TLS itself.
DATABASE_URL=postgresql://neondb_owner:replace-with-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/carbonmesh?sslmode=require
# Local/Docker alternative (unencrypted connections are accepted only for
# loopback and approved Docker service hosts):
# DATABASE_URL=postgresql://carbonmesh:replace-local-password@db:5432/carbonmesh?sslmode=disable

# Background workers scan for expired agent execution leases on this interval.
# Each pass is bounded and performs no schema changes.
AGENT_RECOVERY_INTERVAL_SECONDS=30

# Optional server-side Electricity Maps V4 credential. Keep it out of frontend code,
# request payloads, responses, logs, and committed files.
ELECTRICITY_MAPS_API_TOKEN=
# External calls are bounded; accepted values are 1 through 30 seconds.
ELECTRICITY_MAPS_TIMEOUT_SECONDS=10

# Required to enable the destructive synthetic demo reset endpoint. Use a random
# value of at least 16 characters and send it only as X-Demo-Reset-Token.
DEMO_RESET_TOKEN=

# AI model provider. Leave blank (or use "auto") only when exactly one provider
# key is configured. If several keys are present, select one explicitly:
# openai, gemini, anthropic, or openrouter. Model identifiers are intentionally
# configuration-only because provider model catalogues change over time.
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=15
# Documented compute-footprint proxy assumptions. These estimates are not
# measured energy or measured carbon emissions.
AI_ENERGY_WH_PER_1K_TOKENS=0.3
AI_GRID_INTENSITY_GCO2E_PER_KWH=475

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CarbonMesh

# Evidence vectors use a live provider by default. Hash mode is explicit offline testing only.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
# Defaults to apps/api/.data/sources locally and /app/.data/sources in Docker.
# Compose fixes this path to its persistent source-document volume.
# SOURCE_STORAGE_DIR=

# Every data API requires a server-issued session. Generate separate random keys
# for each real seeded actor; IDs below must match that actor's company and ID.
# AUTH_ACCESS_KEYS is a JSON array of {"key":"<random 32+ chars>","company_id":"<UUID>","actor_id":"<UUID>"}.
AUTH_REQUIRED=false
AUTH_SIGNING_KEY=
AUTH_ACCESS_KEYS=[]
AUTH_SESSION_SECONDS=3600
# Set false only for loopback HTTP development. HTTPS deployments keep true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
# Comma-separated explicit browser origins. Cross-site SSE cookies require
# AUTH_COOKIE_SAMESITE=none with HTTPS and secure cookies.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable correlated request, agent, provider, and SQL-operation spans.
TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=carbonmesh-api
# Optional collector destination; no collector is needed for persisted run traces.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
